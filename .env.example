# Frontend Environment Variables (for Vercel / Local)
VITE_API_URL=https://seo-brilliance-api.onrender.com/api/v1
# VITE_API_URL=http://localhost:5000/api/v1

# Backend Environment Variables (for Render / Local)
DATABASE_URL=postgresql://user:password@localhost:5432/seobrilliance
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your_jwt_secret_here

# Integrations (Phase 4)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
PAGESPEED_API_KEY=your_pagespeed_api_key
SEO_PROVIDER_API_KEY=your_seo_provider_api_key

# Billing (Phase 5)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# AI
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
