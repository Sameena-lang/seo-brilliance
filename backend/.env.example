PORT=5000
NODE_ENV=production

# Render Postgres connection string (External / Internal)
DATABASE_URL="postgresql://user:password@host.singapore-postgres.render.com/seo_db_zyde"

# Auth
JWT_SECRET="your-secure-jwt-secret-key-here"
JWT_EXPIRES_IN="7d"

# Frontend Origin for CORS
